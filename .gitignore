# ---------------------------------------------------------------------------
# ผลลัพธ์ที่สคริปต์สร้างเอง — รวมกันเกือบ 19 MB และสร้างใหม่ได้ทุกไฟล์
# ---------------------------------------------------------------------------
# ถ้าอยากเก็บไฟล์ไหนไว้ใน repo (เช่น เอาไปโชว์ใน README)
# ให้ลบบรรทัดของไฟล์นั้นออก แล้ว git add -f <ไฟล์> หนึ่งครั้ง
#
# คำสั่งที่สร้างแต่ละไฟล์:
#   out.png            python3 leg_kinematics.py --save out.png
#   kinematic_ref.png  python3 servo_map.py --diagram kinematic_ref.png
#   catalog.png        python3 show_gesture.py --sheet catalog.png
#   walk.gif           python3 show_motion.py --gif walk.gif
#   thinking.gif       python3 show_gesture.py --gesture thinking --gif thinking.gif
#   gait_50hz.csv      python3 walking_gait.py --csv gait_50hz.csv
#   motion_*.csv       python3 sleep_wake.py --csv-prefix motion
#   notice_urgent.csv  python3 gestures.py --csv notice_urgent

# รูปนิ่ง
out.png
catalog.png
kinematic_ref.png

# ภาพเคลื่อนไหว (ก้อนใหญ่สุด ~17 MB)
*.gif

# ไทม์ไลน์มุมเซอร์โว 50 Hz
gait_50hz.csv
motion_sleep.csv
motion_wake.csv
notice_urgent.csv

